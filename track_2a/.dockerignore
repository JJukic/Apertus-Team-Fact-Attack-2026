# Build context = track_2a/ (track_2a/Dockerfile, `make run`)
# Secrets and local config: the API key is passed at run time (-e LLM_API_KEY), never baked into the image
.env
.env.*
!.env.example

# Local environments, caches and downloads (sources must be prepared before inference)
.venv
venv
**/__pycache__
**/*.py[cod]
.cache
data/hf
results/*.raw.jsonl

# Editor files
.vscode
.idea
**/.DS_Store

# Experiment outputs and offline gold labels never enter a build context.
**/results
**/docs/evaluation
**/expected-labels.jsonl
