# Apertus / LLM Configuration (CSCS Managed Inference Service)
LLM_NAME=swiss-ai/Apertus-v1.5-8B
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=your_api_key_here

# Strategy: retrieval (default), full, hybrid (weighted BM25), hybrid_dense (BM25 + vectors)
NLI_STRATEGY=retrieval

# Optional: set to 'true' for offline mock testing without API key
MOCK_APERTUS=false

# Optional page-based hybrid retrieval; current NLI default stays unchanged.
# Install track_2a/requirements-hybrid.txt before selecting hybrid_dense.
EMBEDDING_MODEL=BAAI/bge-m3
# Pin a commit; update revision when changing model weights.
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_LENGTH=2048
EMBEDDING_LOCAL_FILES_ONLY=false
# Absolute cache path optional; default is track_2a/.cache/embeddings.
# EMBEDDING_CACHE_DIR=/absolute/path/to/embeddings
HYBRID_CANDIDATES=40
HYBRID_FINAL_PAGES=10
HYBRID_RRF_K=60
# Explicit opt-in fallback; errors otherwise stop dense retrieval.
HYBRID_DENSE_FALLBACK=false
