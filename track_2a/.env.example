# Apertus / LLM Configuration (CSCS Managed Inference Service)
LLM_NAME=swiss-ai/Apertus-v1.5-70B-thinking
BASE_URL=https://api.inference.cscs.ch/v1
API_KEY=your_api_key_here
# Legacy LLM_BASE_URL/LLM_API_KEY are accepted; runtime variables take priority.

# Context strategy: 'hybrid' (recommended), 'retrieval' or 'full'; prompt mode: 'ids' (recommended), 'json' or 'compact'
NLI_STRATEGY=hybrid
NLI_TOP_K=12
PROMPT_MODE=ids
PAGE_MAX_CHARS=3000   # clip over-long pages to their best-matching window (0 = off)
SPEAKER_BOOST=2       # always include the named side's 2 best argument pages (0 = off)

# Optional: set to 'true' for offline mock testing without API key
MOCK_APERTUS=false

# Experiments (off by default, see track_2a/docs/experiments.md)
# THINKING=true            # reason before answering: +2 F1 on dev, ~11x latency
# TRANSLATE_CLAIM=true     # translate cross-lingual claims first: no gain

# Competition experiments: preserve the baseline by default.
# Responses are uncapped; no max_tokens/max_completion_tokens is sent.
LLM_STREAMING=false
LLM_REQUEST_TIMEOUT_S=600
LLM_JSON_REPAIR=false
EVIDENCE_POLICY=legacy   # alternatives: raw_pages, raw_pages_and_blocks
CACHE_SINGLE_FLIGHT=false
SOURCE_PAGES_LAZY=false
BOOKLET_CACHE_DIR=/tmp/fact-attack/booklets
RETRIEVAL_QUERY_MODE=original   # alternatives: translated, union; NLI claim stays original
QUERY_TRANSLATION_CACHE_DIR=/tmp/fact-attack/queries
# REQUEST_JOURNAL_PATH=/output/requests.api.jsonl
