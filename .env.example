# Apertus / LLM Configuration (CSCS Managed Inference Service)
LLM_NAME=swiss-ai/Apertus-v1.5-70B-thinking
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=your_api_key_here

# Context strategy: 'hybrid' (recommended), 'retrieval' or 'full'; prompt mode: 'ids' (recommended), 'json' or 'compact'
NLI_STRATEGY=hybrid
NLI_TOP_K=10
PROMPT_MODE=ids

# Optional: set to 'true' for offline mock testing without API key
MOCK_APERTUS=false

# Experiments (off by default, see track_2a/docs/experiments.md)
# THINKING=true            # reason before answering: ~+3 F1, ~10x latency
# TRANSLATE_CLAIM=true     # translate cross-lingual claims first: no gain
